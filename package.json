{
  "name": "task-tracker-realtime",
  "version": "1.0.0",
  "description": "Real-time team kanban board built with Express, Socket.io and SQLite. Tasks update live across every open browser tab.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "kanban",
    "express",
    "socket.io",
    "realtime",
    "sqlite",
    "jwt",
    "nodejs",
    "task-tracker"
  ],
  "author": "Mohammad Gulab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohammadgulab/task-tracker-realtime"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
